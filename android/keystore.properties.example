# Copy to android/keystore.properties and fill in. NEVER commit the real file.
#
# This MUST stay the same key that signed the original TWA APK, otherwise
# Android refuses to install the new app over the old one and every phone
# needs a manual uninstall first.
#
# storeFile is relative to the android/ directory.
storeFile=../twa/android.keystore
storePassword=CHANGE_ME
keyAlias=android
keyPassword=CHANGE_ME
