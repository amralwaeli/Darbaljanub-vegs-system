# Copy to .env and fill in. ONLY the anon key ever reaches the browser —
# it is safe because RLS is default-deny on every table.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
# Display-only currency symbol used in price formatting
VITE_CURRENCY=$
# Auto-logout after this many hours of NO app use (activity resets the timer).
# LEAVE EMPTY to keep staff signed in until they tap Logout — the default.
VITE_INACTIVITY_HOURS=
# Web Push (notifications): PUBLIC key from `npx web-push generate-vapid-keys`.
# Leave empty to hide the notifications bell entirely.
VITE_VAPID_PUBLIC_KEY=

# --- scripts/seed.mjs ONLY (never in the frontend, never committed) ---------
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
