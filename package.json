{
  "name": "darbaljanub-vegs-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup-data.mjs",
    "restore": "node scripts/restore-data.mjs",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "build:native": "node scripts/build-native.mjs",
    "ota:bundle": "node scripts/make-ota-bundle.mjs",
    "sync": "npm run build:native && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.13",
    "@supabase/supabase-js": "2.49.4",
    "@tanstack/react-query": "5.66.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "adm-zip": "^0.6.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.2.0",
    "vite-plugin-pwa": "0.21.1",
    "workbox-core": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0"
  }
}
