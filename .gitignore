node_modules
dist
dev-dist
*.tsbuildinfo
SETUP_ALL_MIGRATIONS.sql
RESET_DATABASE.sql

# Android TWA wrapper: keystore + generated project + build outputs never
# leave this machine. The manifest and the Digital Asset Links files hold no
# secrets (a cert fingerprint is public by design) and are tracked.
twa/*
!twa/twa-manifest.json
!twa/assetlinks.json
!twa/pages-root/
!twa/pages-root/**
.env
.env.local
# Data snapshots from scripts/backup-data.mjs — contain PII (names, emails, IPs)
backups/
*.local
.DS_Store
supabase/.temp/

# Native Android (Capacitor). The android/ project IS tracked — it holds real
# configuration (signing setup, versionCode, manifest) — but never secrets or
# build output.
# (google-services.json is NOT ignored: it holds no secrets and the app
#  cannot receive notifications without it — keep it in the repo.)
android/keystore.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
# OTA bundles are build artifacts produced by CI on every deploy.
ota/
